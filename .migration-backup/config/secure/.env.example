# GXEON Supreme Configuration
# Generated from gxeon_supreme_config

# ==========================================
# SUPABASE
# ==========================================
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here  

# ==========================================
# WEB3 / WALLET
# ==========================================
WEB3_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS
WEB3_NETWORK=Ethereum
WALLET_PRIVATE_KEY=your_private_key_here
METAMASK_API_KEY=your-metamask-api-key
METAMASK_WALLET_KEY=your-wallet-key

# ==========================================
# SMART CONTRACTS
# ==========================================
SMART_CONTRACT_ADDRESS=0x...

# ==========================================
# AI APIs
# ==========================================
OPENROUTER_API_KEY=your_openrouter_api_key_here

HUGGINGFACE_API_KEY=your_huggingface_api_key_here
GROK_API_KEY=your_grok_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
CHATGPT_API_KEY=your_chatgpt_api_key_here
BITENSOR_API_KEY=your_bitensor_api_key_here
RPC_URL=your_rpc_url_here

# ==========================================
# GXEON MODULES
# ==========================================
BRAIN_STATUS=active
VECTOR_DB_STATUS=active
HUGGINGFACE_STATUS=connected
DEEPSEEK_STATUS=connected
GROK_STATUS=connected
CHATGPT_STATUS=connected
BITENSOR_STATUS=connected
MONETIZATION_PLUGIN_PLAY=active
MONETIZATION_SMART_CONTRACTS=active
MONETIZATION_AGENTS=active
MONETIZATION_MICROTASKS=active

# ==========================================
# MARKETPLACE
# ==========================================
MARKETPLACE_API_KEY=your-marketplace-api-key

# ==========================================
# WEB3 FLOW
# ==========================================
AUTO_CONNECT_WALLET=true
PAYMENT_ON_TASK_COMPLETION=true
MICROTASKS_ENABLED=true

# ==========================================
# SERVER
# ==========================================
PORT=3000
NODE_ENV=development
