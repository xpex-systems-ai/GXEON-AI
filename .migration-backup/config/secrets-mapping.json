{
  "_description": "🔐 GXEON AI — Secrets & Environment Variables Mapping",
  "_warning": "NEVER commit this file with real values. Use GitHub Secrets or Replit Secrets.",
  
  "required_secrets": {
    "SUPABASE_URL": {
      "description": "Supabase project URL",
      "example": "https://xyz123.supabase.co",
      "where_to_get": "Supabase Dashboard → Project Settings → API",
      "github_secret_name": "SUPABASE_URL",
      "replit_key": "SUPABASE_URL"
    },
    "SUPABASE_SERVICE_ROLE_KEY": {
      "description": "Supabase service role key (admin access)",
      "example": "YOUR_SUPABASE_JWT_TOKEN",
      "where_to_get": "Supabase Dashboard → Project Settings → API → service_role key",
      "github_secret_name": "SUPABASE_SERVICE_ROLE_KEY",
      "replit_key": "SUPABASE_SERVICE_ROLE_KEY",
      "danger": "⚠️ This key bypasses RLS - keep it secret!"
    },
    "DATABASE_URL": {
      "description": "Direct PostgreSQL connection string",
      "example": "postgresql://postgres:password@db.xyz123.supabase.co:5432/postgres",
      "where_to_get": "Supabase Dashboard → Database → Connection String",
      "github_secret_name": "DATABASE_URL",
      "replit_key": "DATABASE_URL",
      "danger": "⚠️ Contains password - never expose!"
    },
    "PRIVATE_KEY": {
      "description": "Ethereum wallet private key for M2M operations",
      "example": "0xabc123...",
      "where_to_get": "Create new wallet or export from MetaMask",
      "github_secret_name": "PRIVATE_KEY",
      "replit_key": "PRIVATE_KEY",
      "danger": "🔥 CRITICAL: This controls funds - maximum security required!"
    },
    "ARBITRUM_RPC_URL": {
      "description": "Arbitrum One RPC endpoint",
      "example": "https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY",
      "where_to_get": "Alchemy, Infura, or QuickNode dashboard",
      "github_secret_name": "ARBITRUM_RPC_URL",
      "replit_key": "ARBITRUM_RPC_URL"
    },
    "ETHEREUM_RPC_URL": {
      "description": "Ethereum Mainnet RPC endpoint",
      "example": "https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY",
      "where_to_get": "Alchemy, Infura, or QuickNode dashboard",
      "github_secret_name": "ETHEREUM_RPC_URL",
      "replit_key": "ETHEREUM_RPC_URL"
    },
    "POLYGON_RPC_URL": {
      "description": "Polygon Mainnet RPC endpoint",
      "example": "https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY",
      "where_to_get": "Alchemy, Infura, or QuickNode dashboard",
      "github_secret_name": "POLYGON_RPC_URL",
      "replit_key": "POLYGON_RPC_URL"
    },
    "FLASHBOTS_RELAY_SIGNING_KEY": {
      "description": "Flashbots relay signing key for MEV bundles",
      "example": "0xdef456...",
      "where_to_get": "Generate new key or use same as PRIVATE_KEY",
      "github_secret_name": "FLASHBOTS_RELAY_SIGNING_KEY",
      "replit_key": "FLASHBOTS_RELAY_SIGNING_KEY",
      "optional": true
    },
    "OFA_API_KEY_0X": {
      "description": "0x API key for Order Flow Auction",
      "example": "12345678-abcd-efgh-ijkl-123456789012",
      "where_to_get": "0x Dashboard → API Keys",
      "github_secret_name": "OFA_API_KEY_0X",
      "replit_key": "OFA_API_KEY_0X",
      "optional": true
    },
    "OFA_API_KEY_1INCH": {
      "description": "1inch API key for Order Flow Auction",
      "example": "abcdef1234567890abcdef1234567890",
      "where_to_get": "1inch Developer Portal",
      "github_secret_name": "OFA_API_KEY_1INCH",
      "replit_key": "OFA_API_KEY_1INCH",
      "optional": true
    }
  },
  
  "setup_instructions": {
    "github_actions": {
      "steps": [
        "1. Go to GitHub repository → Settings → Secrets and variables → Actions",
        "2. Click 'New repository secret'",
        "3. Add each secret from 'github_secret_name' above",
        "4. The workflow .github/workflows/gxeon-autonomous.yml will use these automatically"
      ],
      "url": "https://github.com/xpex-systems-ai/GXEON-AI/settings/secrets/actions"
    },
    "replit": {
      "steps": [
        "1. Open project in Replit",
        "2. Click 'Secrets' (lock icon) in left sidebar",
        "3. Add each secret from 'replit_key' above",
        "4. Replit will automatically inject these into environment"
      ],
      "url": "https://replit.com/@YOUR_USERNAME/GXEON-AI"
    },
    "local_development": {
      "steps": [
        "1. Copy .env.example to .env",
        "2. Fill in all values from this mapping",
        "3. Never commit .env to git!",
        "4. Run: npm install && npm start"
      ]
    }
  },
  
  "verification": {
    "test_command": "node scripts/live_ping_supabase.js",
    "expected_output": "All systems operational",
    "health_check_url": "https://api.gxeon.ai/health"
  }
}
