# 🔥 GXEON PHOENIX-SENTINEL v22 — Dockerfile
# Protocolo: SYSTEM_IMMUNITY_CHECK
# Node.js 22 Alpine — Auto-Scaling Enabled
# Treasury: 0x3955d559055DadB7067054cB6E6f974710345224

FROM node:22-alpine

# Set working directory
WORKDIR /app

# Install system dependencies (required for some npm packages)
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    git

# Copy package files first (for better layer caching)
COPY package*.json ./

# Cache bust para forçar rebuild limpo
ARG CACHE_BUST=1

# Install dependencies (NPM_INSTALL_FORCE_BYPASS)
RUN npm install --legacy-peer-deps 2>&1 || npm install --force 2>&1 || npm install 2>&1 ; npm cache clean --force

# Copy application code
COPY . .

# Create non-root user for security
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Change ownership to non-root user
RUN chown -R nodejs:nodejs /app
USER nodejs

# Cloud Run requires port 8080
ENV PORT=8080
ENV NODE_ENV=production

# Expose the required port
EXPOSE 8080

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD node -e "require('http').get('http://localhost:8080/api/health', (r) => r.statusCode === 200 ? process.exit(0) : process.exit(1))"

# Sentinel Guardian Activation
ENV SENTINEL_ENABLED=true
ENV SENTINEL_LATENCY_THRESHOLD_MS=100
ENV SENTINEL_BUFFER_LIMIT=1000
ENV SENTINEL_AUTO_RESTART=true
ENV BATCH_SYNC_THRESHOLD=5

# Start application (Sentinel via bridge opcional)
CMD ["node", "server/index.js"]
