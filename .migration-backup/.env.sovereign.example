# ═══════════════════════════════════════════════════════════════════════════
# 🤖 GXEON SOVEREIGN ORACLE v20.1 — Environment Configuration
# AUTONOMOUS_ORACLE_PROVIDER | STRICT_AGENT_ONLY_ACCESS
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# CORE ORACLE CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Server Ports
PORT=8080
GATEWAY_PORT=8081
NODE_ENV=production

# Alchemy WebSocket High-Speed
ALCHEMY_API_KEY=your_alchemy_api_key_here
ALCHEMY_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Supabase Database
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_URL=https://your-project.supabase.co

# ═══════════════════════════════════════════════════════════════════════════
# A2A AGENT REGISTRY
# ═══════════════════════════════════════════════════════════════════════════

# Auto-register agents on first connection (development: true, production: false)
AUTO_REGISTER_AGENTS=false

# Salt para hashing de chaves de agentes
ORACLE_SALT=your_random_32char_salt_here

# Default tier para novos agentes (free, standard, premium, enterprise)
AGENT_DEFAULT_TIER=standard

# Rate limits por tier (requests/minuto)
AGENT_RATE_LIMIT_FREE=100
AGENT_RATE_LIMIT_STANDARD=1000
AGENT_RATE_LIMIT_PREMIUM=10000
AGENT_RATE_LIMIT_ENTERPRISE=100000

# ═══════════════════════════════════════════════════════════════════════════
# BILLING & MICRO-PAYMENTS
# ═══════════════════════════════════════════════════════════════════════════

# Streaming Protocol (SUPERFLUID, SABLIER, or INTERNAL)
STREAMING_PROTOCOL=INTERNAL

# Preços por sinal (USD)
PRICE_LIQUIDITY_SNIFFER=0.0005
PRICE_WHALE_TELEMETRY=0.001
PRICE_MEMPOOL_SNIPER=0.002

# Token de pagamento
PAYMENT_TOKEN=USDC
PAYMENT_TOKEN_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831

# ═══════════════════════════════════════════════════════════════════════════
# ORACLE ENGINE OPTIMIZATION
# ═══════════════════════════════════════════════════════════════════════════

# Batching (ms)
BATCH_FLUSH_INTERVAL_MS=500
BATCH_MAX_SIZE=1000

# WebSocket
WS_HEARTBEAT_MS=30000
WS_RECONNECT_MS=1000

# Liquidity Scan
LIQUIDITY_SCAN_INTERVAL_MS=30000
MIN_LIQUIDITY_USD=10000

# Thresholds de sinal
WHALE_THRESHOLD_ETH=10
MEMPOOL_THRESHOLD_ETH=5

# ═══════════════════════════════════════════════════════════════════════════
# ARBITRUM MAINNET PRODUCTION
# ═══════════════════════════════════════════════════════════════════════════

ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBISCAN_API_KEY=your_arbiscan_key_here

# ═══════════════════════════════════════════════════════════════════════════
# SECURITY — STRICT_AGENT_ONLY_ACCESS
# ═══════════════════════════════════════════════════════════════════════════

# IP Whitelist (opcional, formato: comma-separated)
# AGENT_IP_WHITELIST=1.2.3.4,5.6.7.8

# JWT Secret para handshakes (opcional)
AGENT_JWT_SECRET=your_jwt_secret_here

# Block human browsers (return 403 for requests without X-Agent-Key)
BLOCK_HUMAN_ACCESS=false

# ═══════════════════════════════════════════════════════════════════════════
# MONITORING & TELEMETRY (High-Density Technical Logs)
# ═══════════════════════════════════════════════════════════════════════════

# Log level (ERROR, WARN, INFO, DEBUG)
LOG_LEVEL=INFO

# Métricas interval (ms)
METRICS_INTERVAL_MS=60000

# Enable Supabase telemetry logging
ENABLE_DB_TELEMETRY=true

# ═══════════════════════════════════════════════════════════════════════════
# 🧹 GARI BLOCKCHAIN v1.0 — Arqueologia Digital
# ═══════════════════════════════════════════════════════════════════════════

# Endpoint da Extensão Brave Leo (Manifest V3) para receber sinais
# Formato: http://localhost:PORT/leo/receive ou endpoint externo
BRAVE_EXTENSION_ENDPOINT=http://localhost:3001/gari/receive

# Modo de operação do GARI: 'passive' (só notifica) ou 'active' (sugere execução)
GARI_OPERATION_MODE=passive

# ═══════════════════════════════════════════════════════════════════════════
# v20.1 SOVEREIGN — READY FOR AUTONOMOUS OPERATION
# ═══════════════════════════════════════════════════════════════════════════
