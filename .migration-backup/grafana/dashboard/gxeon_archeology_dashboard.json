{
  "dashboard": {
    "title": "GXEON Predator v4.0 - Digital Archeology Ledger",
    "tags": ["gxeon", "predator", "monetization", "archeology"],
    "timezone": "utc",
    "schemaVersion": 36,
    "refresh": "5s",
    "theme": "dark",
    "annotations": {
      "list": [
        {
          "name": "AI Confidence Rejections",
          "datasource": "Supabase",
          "expr": "SELECT * FROM grafana_alert_logs WHERE alert_type = 'AI_CONFIDENCE_REJECTION' AND created_at > NOW() - INTERVAL '1 hour'",
          "tagKeys": "severity,opportunity_id",
          "textFormat": "Confidence {{confidence}} < 0.85 - Profit ${{potential_profit_usd}}",
          "iconColor": "rgba(255, 0, 0, 1)"
        }
      ]
    },
    "panels": [
      {
        "id": 1,
        "title": "💰 Total Profit USD (24h)",
        "type": "stat",
        "targets": [
          {
            "datasource": "Supabase",
            "rawSql": "SELECT SUM(net_profit_usd) as value FROM digital_archeology_ledger WHERE status = 'confirmed' AND created_at >= NOW() - INTERVAL '24 hours'",
            "format": "table"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "area",
          "justifyMode": "center"
        },
        "fieldConfig": {
          "defaults": {
            "color": {
              "mode": "fixed",
              "fixedColor": "gold"
            },
            "unit": "currencyUSD",
            "thresholds": {
              "steps": [
                {"color": "#1F1F1F", "value": null},
                {"color": "#FFD700", "value": 100},
                {"color": "#FFA500", "value": 1000}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "📊 Success Rate",
        "type": "gauge",
        "targets": [
          {
            "datasource": "Supabase",
            "rawSql": "SELECT (COUNT(*) FILTER (WHERE status = 'confirmed') * 100.0 / NULLIF(COUNT(*), 0)) as value FROM digital_archeology_ledger WHERE created_at >= NOW() - INTERVAL '24 hours'",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "min": 0,
            "max": 100,
            "unit": "percent",
            "thresholds": {
              "steps": [
                {"color": "red", "value": 0},
                {"color": "yellow", "value": 70},
                {"color": "green", "value": 85}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "⛽ Gas Spent (24h)",
        "type": "stat",
        "targets": [
          {
            "datasource": "Supabase",
            "rawSql": "SELECT SUM(gas_cost_usd) as value FROM digital_archeology_ledger WHERE created_at >= NOW() - INTERVAL '24 hours'",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "fixed", "fixedColor": "cyan"},
            "unit": "currencyUSD"
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "🤖 AI Confidence Average",
        "type": "stat",
        "targets": [
          {
            "datasource": "Supabase",
            "rawSql": "SELECT AVG(ai_confidence_score) as value FROM digital_archeology_ledger WHERE created_at >= NOW() - INTERVAL '24 hours'",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "fixed", "fixedColor": "blue"},
            "unit": "percentunit",
            "decimals": 2,
            "thresholds": {
              "steps": [
                {"color": "red", "value": null},
                {"color": "yellow", "value": 0.70},
                {"color": "#00FF00", "value": 0.85}
              ]
            }
          }
        },
        "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0}
      },
      {
        "id": 5,
        "title": "📈 Profit Timeline",
        "type": "timeseries",
        "targets": [
          {
            "datasource": "Supabase",
            "rawSql": "SELECT DATE_TRUNC('hour', created_at) as time, SUM(net_profit_usd) as profit FROM digital_archeology_ledger WHERE status = 'confirmed' AND created_at >= NOW() - INTERVAL '24 hours' GROUP BY 1 ORDER BY 1",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "fixed", "fixedColor": "gold"},
            "custom": {"lineWidth": 3, "fillOpacity": 20}
          }
        },
        "gridPos": {"h": 10, "w": 12, "x": 0, "y": 8}
      },
      {
        "id": 6,
        "title": "🚨 Low Confidence Rejections",
        "type": "table",
        "targets": [
          {
            "datasource": "Supabase",
            "rawSql": "SELECT id, ai_confidence_score as confidence, gross_profit_usd as profit, created_at, 'REJECTED_BY_AI' as reason FROM digital_archeology_ledger WHERE ai_confidence_score < 0.85 AND status = 'rejected' AND created_at >= NOW() - INTERVAL '24 hours' ORDER BY created_at DESC LIMIT 50",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "overrides": [
            {
              "matcher": {"id": "byName", "options": "confidence"},
              "properties": [
                {
                  "id": "custom.displayMode",
                  "value": "gradient-gauge"
                },
                {
                  "id": "thresholds",
                  "value": {
                    "steps": [
                      {"color": "red", "value": null},
                      {"color": "yellow", "value": 0.70},
                      {"color": "green", "value": 0.85}
                    ]
                  }
                }
              ]
            }
          ]
        },
        "gridPos": {"h": 10, "w": 12, "x": 12, "y": 8}
      },
      {
        "id": 7,
        "title": "🔐 Wallet Alignment Status",
        "type": "stat",
        "targets": [
          {
            "datasource": "Supabase",
            "rawSql": "SELECT COUNT(*) as value FROM digital_archeology_ledger WHERE destination_address = '0x3955d559055DadB7067054cB6E6f974710345224' AND created_at >= NOW() - INTERVAL '24 hours'",
            "format": "table"
          }
        ],
        "options": {
          "textMode": "value_and_name"
        },
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "fixed", "fixedColor": "green"}
          }
        },
        "gridPos": {"h": 6, "w": 8, "x": 0, "y": 18}
      },
      {
        "id": 8,
        "title": "⚡ Circuit Breaker 429 Status",
        "type": "stat",
        "targets": [
          {
            "datasource": "JSON API",
            "url": "${GXEON_API_URL}/api/v1/health/alchemy",
            "cacheDurationSeconds": 5
          }
        ],
        "options": {
          "colorMode": "background"
        },
        "fieldConfig": {
          "defaults": {
            "mappings": [
              {"options": {"0": {"text": "ONLINE", "color": "green"}}, "type": "value"},
              {"options": {"1": {"text": "RATE LIMITED", "color": "red"}}, "type": "value"}
            ]
          }
        },
        "gridPos": {"h": 6, "w": 8, "x": 8, "y": 18}
      },
      {
        "id": 9,
        "title": "🎯 Fee Protection Buffer (15%)",
        "type": "stat",
        "targets": [
          {
            "datasource": "Supabase",
            "rawSql": "SELECT SUM(fee_buffer_amount_usd) as value FROM digital_archeology_ledger WHERE created_at >= NOW() - INTERVAL '24 hours'",
            "format": "table"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "color": {"mode": "fixed", "fixedColor": "purple"},
            "unit": "currencyUSD"
          }
        },
        "gridPos": {"h": 6, "w": 8, "x": 16, "y": 18}
      }
    ],
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "templating": {
      "list": [
        {
          "name": "GXEON_API_URL",
          "type": "constant",
          "current": {"value": "https://your-gxeon-api.railway.app"}
        }
      ]
    }
  }
}
