# ═══════════════════════════════════════════════════════════════════════════
# GRAFANA ALLOY - ENVIRONMENT VARIABLES
# CONEXÃO COMPLETA GRAFANA + SUPABASE
# 
# ⚠️  ATENÇÃO: Arquivo sensível - NUNCA commite!
# Copie para .env e preencha seus valores reais
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# GRAFANA CLOUD CREDENTIALS
# Obtenha em: https://grafana.com/login → My Account → Your Stack
# ═══════════════════════════════════════════════════════════════════════════

# URL do Prometheus Remote Write (Metrics)
# Exemplo: https://prometheus-prod-24-prod-us-east-0.grafana.net/api/prom/push
GRAFANA_REMOTE_WRITE_URL=https://prometheus-prod-SEU-REGION.grafana.net/api/prom/push

# User ID (número no topo da página do Grafana Stack)
GRAFANA_REMOTE_WRITE_USERNAME=123456

# API Key (criar em: Security → API Keys → Create API Key, Role: Admin)
GRAFANA_API_KEY=glsa_SUA_CHAVE_AQUI_XXXXXXXXXXXXXXXXXXXXXXXX

# URL do Loki (Logs)
# Exemplo: https://logs-prod-24.grafana.net/loki/api/v1/push  
GRAFANA_LOKI_URL=https://logs-prod-SEU-REGION.grafana.net/loki/api/v1/push

# Tempo Endpoint (Traces/APM)
# Exemplo: tempo-prod-24-prod-us-east-0.grafana.net:443
GRAFANA_TEMPO_ENDPOINT=tempo-prod-SEU-REGION.grafana.net:443

# ═══════════════════════════════════════════════════════════════════════════
# SUPABASE CREDENTIALS
# Obtenha em: https://supabase.com/dashboard/project/telxvphgrsvsnxvmjkce/settings/database
# ═══════════════════════════════════════════════════════════════════════════

# Connection Info do Supabase
SUPABASE_DB_HOST=db.telxvphgrsvsnxvmjkce.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres

# Senha do banco (definida ao criar projeto ou resetada em Settings)
SUPABASE_DB_PASSWORD=sua_senha_aqui

# SSL Mode (sempre require para Supabase)
SUPABASE_DB_SSL=require

# Connection Pooling (opcional, recomendado para produção)
# Porta 6543 com PgBouncer
SUPABASE_POOLER_URL=postgresql://postgres:sua_senha@db.telxvphgrsvsnxvmjkce.supabase.co:6543/postgres?pgbouncer=true

# Service Role Key (para acesso admin via API)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ═══════════════════════════════════════════════════════════════════════════
# ALLOY CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

# Intervalo de scrape (quanto tempo entre coletas)
ALLOY_SCRAPE_INTERVAL=30s

# Porta do servidor HTTP interno do Alloy
ALLOY_HTTP_PORT=12345

# Nível de log (info, debug, warn, error)
ALLOY_LOG_LEVEL=info

# ═══════════════════════════════════════════════════════════════════════════
# GXEON FLEET SPECIFIC
# ═══════════════════════════════════════════════════════════════════════════

# Endereço do Treasury (fixo - não alterar)
TREASURY_ADDRESS=0x3955d559055DadB7067054cB6E6f974710345224

# Modo de operação
FLEET_PRODUCTION_MODE=true

# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL: Connection String Completa (para psql ou apps)
# ═══════════════════════════════════════════════════════════════════════════

# Formato completo para psql
SUPABASE_URL=postgresql://postgres:sua_senha@db.telxvphgrsvsnxvmjkce.supabase.co:5432/postgres?sslmode=require

# ═══════════════════════════════════════════════════════════════════════════
# INSTRUÇÕES:
# ═══════════════════════════════════════════════════════════════════════════
# 
# 1. Copie este arquivo: cp .env.example .env
# 2. Edite .env com suas credenciais reais
# 3. NUNCA commite .env (já está no .gitignore)
# 4. Teste conexão: psql "$SUPABASE_URL" -c "SELECT 1"
# 5. Inicie Alloy: alloy run grafana/config/alloy-config.river
# 
# ═══════════════════════════════════════════════════════════════════════════
