    },
    "AgenteMercadoPago": {
      "type": "PaymentGateway",
      "method": "MercadoPago",
      "currency": "BRL",
      "runtime": "gateway",
      "validation": {
        "api_keys": "secured_env",
        "policies": ["auth_flow", "webhook_integrity"]
      },
      "output": {
        "transaction_id": "MP_TX_ID",
        "status": "confirmed",
        "notification": "MP_PAYMENT_CONFIRMED"
      }
    },
    "AgenteA2A": {
      "type": "AgentToAgent",
