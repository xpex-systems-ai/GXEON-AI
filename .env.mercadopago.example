# GXEON Mercado Pago production env template.
# Copy to a secret store or an untracked .env.production.local file.
# Never commit real Mercado Pago credentials, PIX keys, webhook secrets, or financial auth tokens.

MERCADO_PAGO_PUBLIC_KEY=APP_USR-REPLACE_WITH_PUBLIC_KEY
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-REPLACE_WITH_PRODUCTION_ACCESS_TOKEN
MERCADO_PAGO_CLIENT_ID=REPLACE_WITH_CLIENT_ID
MERCADO_PAGO_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
MERCADO_PAGO_PIX_KEY=REPLACE_WITH_PIX_KEY_OR_EMAIL_OR_CPF_OR_RANDOM_KEY
MERCADO_PAGO_NOTIFICATION_URL=https://YOUR_API_HOST/api/v1/webhooks/mercado-pago
MERCADO_PAGO_WEBHOOK_SECRET=REPLACE_WITH_STRONG_RANDOM_WEBHOOK_SECRET
MERCADO_PAGO_DEFAULT_PAYER_EMAIL=buyer@example.com

FINANCIAL_AUTH_TOKEN=REPLACE_WITH_STRONG_RANDOM_FINANCIAL_TOKEN
FINANCIAL_AUTH_SCOPES=financial:*
