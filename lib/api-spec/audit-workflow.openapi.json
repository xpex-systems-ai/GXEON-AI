  "components": {
    "securitySchemes": {
      "auditBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Intake": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "assetName",
          "assetReference",
          "authorizationReference",
          "authorized",
          "testData",
          "checks",
          "artifact"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "assetName": {
            "type": "string",
            "minLength": 3,
            "maxLength": 180
          },
          "assetReference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "authorizationReference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          },
          "authorized": {
            "const": true
          },
          "testData": {
            "type": "boolean"
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": {
              "enum": ["vercel_api_routing", "vercel_security_headers"]
            }
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "content"],
            "properties": {
              "name": {
                "const": "vercel.json"
              },
              "content": {
                "type": "string",
                "minLength": 2,
                "maxLength": 16000
              }
            }
          }
        }
      },
      "Review": {
        "type": "object",
        "additionalProperties": false,
        "required": ["decision", "humanReviewed", "reviewReference"],
        "properties": {
          "decision": {
            "enum": ["approve", "reject"]
          },
          "humanReviewed": {
            "const": true
          },
          "reviewReference": {
            "type": "string",
            "minLength": 3,
            "maxLength": 500
          }
        }
      },
      "Action": {
        "type": "object",
        "required": ["ok", "caseId", "status"],
        "properties": {
          "ok": {
            "const": true
          },
          "caseId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "enum": ["DRAFT", "IN_REVIEW", "READY_FOR_REPORT", "CLOSED"]
          },
          "reportId": {
            "type": "string",
            "format": "uuid"
          },
          "evidenceId": {
            "type": "string",
            "format": "uuid"
          },
          "reused": {
            "type": "boolean"
          }
        }
      },
      "Error": {
        "type": "object",
        "required": ["ok", "code"],
        "properties": {
          "ok": {
            "const": false
          },
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "Detail": {
        "type": "object",
        "required": ["ok", "item", "evidences", "findings", "reports"],
        "properties": {
          "ok": {
            "const": true
          },
          "item": {
            "type": "object",
            "required": ["id", "title", "status", "metadata"],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "title": {
                "type": "string"
              },
              "status": {
                "enum": ["DRAFT", "IN_REVIEW", "READY_FOR_REPORT", "CLOSED"]
              },
              "metadata": {
                "type": "object"
              }
            }
          },
          "evidences": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "reports": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "Export": {
        "type": "object",
        "required": ["ok", "caseId", "reportId", "sha256", "report"],
        "properties": {
          "ok": {
            "const": true
          },
          "caseId": {
            "type": "string",
            "format": "uuid"
          },
          "reportId": {
            "type": "string",
            "format": "uuid"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "report": {
            "type": "object",
            "description": "Reviewed immutable snapshot: scope, testData flag, findings with evidence IDs, submitted evidence text and hashes, limitations, review attestation, state history and finalStatus CLOSED. Runtime Zod schema is authoritative."
          }
        }
      }
    }
  }
