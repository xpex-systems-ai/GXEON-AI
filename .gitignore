# ═══════════════════════════════════════════════════════════════
# 🛡️ GXEON AI — SECURITY FORTRESS — .gitignore
# ═══════════════════════════════════════════════════════════════
# ABSOLUTELY NEVER COMMIT THESE FILES:

# 🔐 Environment & Secrets
.env
.env.local
.env.*.local
.env.production
.env.staging
.env.development
config/secure/.env
config/secrets.json
config/*.key
config/*.pem
config/*.p12

# 🔑 Private Keys & Wallets
*.private.key
*.wallet.json
keystore/
wallets/
mnemonic.txt
seed.txt
private_keys/

# 🗄️ Database URLs & Credentials
DATABASE_URL
DATABASE_URL_LOCAL
SUPABASE_SERVICE_ROLE_KEY
SUPABASE_ANON_KEY
POSTGRES_PASSWORD

# 🔗 Blockchain Keys
PRIVATE_KEY
ETHERSCAN_API_KEY
INFURA_API_KEY
ALCHEMY_API_KEY
QUICKNODE_API_KEY
FLASHBOTS_RELAY_KEY

# 📊 Logs & Debug Files
*.log
logs/
debug/
*.debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 💻 System Files
.DS_Store
Thumbs.db
*.swp
*.swo
*~
.vscode/settings.json
.idea/

# 📦 Dependencies
node_modules/
npm_modules/
.pnp
.pnp.js

# 🏗️ Build & Deploy
.vercel
.netlify
dist/
build/
coverage/
*.tgz
*.tar.gz

# ⚠️ Specific Security Exclusions
server/routes/sepolia-executor.js
temp/
tmp/
cache/
*.cache

# 🚫 Never commit compiled contracts with embedded keys
artifacts/*/.env
artifacts/*/debug/

# 🚫 Railway/Nixpacks build cache
.nixpacks/
nixpacks.toml
