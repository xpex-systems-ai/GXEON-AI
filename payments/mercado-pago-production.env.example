# GXEON Mercado Pago production PIX configuration
# Never commit real values. Configure these in Railway/Replit/Supabase secrets or local untracked .env only.

# Required for real PIX checkout creation.
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DB
MERCADO_PAGO_ACCESS_TOKEN=APP_USR-REPLACE_WITH_PRODUCTION_ACCESS_TOKEN
MERCADO_PAGO_WEBHOOK_SECRET=REPLACE_WITH_STRONG_RANDOM_WEBHOOK_SECRET

# Strongly recommended so Mercado Pago can notify GXEON when PIX is paid.
MERCADO_PAGO_NOTIFICATION_URL=https://YOUR_API_HOST/api/v1/webhooks/mercado-pago

# Optional operational metadata/readiness checks. Keep them in the secret manager, not in git.
MERCADO_PAGO_PUBLIC_KEY=APP_USR-REPLACE_WITH_PUBLIC_KEY
MERCADO_PAGO_CLIENT_ID=REPLACE_WITH_CLIENT_ID
MERCADO_PAGO_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# Accepts CPF, e-mail, random key, phone key, or CNPJ depending on your Mercado Pago account.
MERCADO_PAGO_PIX_KEY=REPLACE_WITH_PIX_KEY_OR_EMAIL

# Optional fallback payer email for automated radar monetization tests.
# Prefer passing the buyer email per checkout request in production.
MERCADO_PAGO_DEFAULT_PAYER_EMAIL=buyer@example.com

# Required by protected financial mutation endpoints. Generate a strong random value.
FINANCIAL_AUTH_TOKEN=REPLACE_WITH_STRONG_RANDOM_FINANCIAL_TOKEN
FINANCIAL_AUTH_SCOPES=financial:*
