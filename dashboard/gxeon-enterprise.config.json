{
  "enterprise_dashboard": {
    "version": "2.0.0-EXEC",
    "name": "GXEON Supreme Enterprise",
    "refresh_interval_ms": 3000,
    "theme": "enterprise-dark",
    "alerts": {
      "channels": {
        "slack": {
          "enabled": true,
          "webhook_url": "${SLACK_WEBHOOK_URL}"
        },
        "email": {
          "enabled": true,
          "smtp_config": "${EMAIL_SMTP_CONFIG}"
        }
      },
      "triggers": {
        "task_failure": {
          "severity": "critical",
          "channels": ["slack", "email"],
          "threshold": 1
        },
        "reward_delay": {
          "severity": "warning",
          "channels": ["slack"],
          "threshold": 300
        },
        "payment_error": {
          "severity": "critical",
          "channels": ["slack", "email"],
          "threshold": 1
        },
        "pipeline_stall": {
          "severity": "warning",
          "channels": ["slack"],
          "threshold": 600
        }
      }
    },
    "metrics": {
      "display": [
        "tasks_pending",
        "tasks_completed",
        "tasks_processing",
        "tasks_failed",
        "rewards_generated",
        "rewards_pending",
        "payments_executed",
        "payments_failed",
        "pipeline_errors",
        "system_health",
        "agent_latency",
        "throughput_tps"
      ],
      "retention_days": 30
    },
    "logs": {
      "streaming": true,
      "buffer_size": 1000,
      "levels": ["info", "warn", "error", "debug"],
      "sources": [
        "execution_agent",
        "reward_engine",
        "payment_engine",
        "marketplace_engine",
        "ai_decision_engine",
        "task_generator"
      ]
    },
    "panels": {
      "pipeline_overview": {
        "enabled": true,
        "position": "top",
        "refresh": 3000
      },
      "web3_financial": {
        "enabled": true,
        "position": "middle",
        "refresh": 5000
      },
      "marketplace_ledger": {
        "enabled": true,
        "position": "middle",
        "refresh": 3000
      },
      "activity_timeline": {
        "enabled": true,
        "position": "middle",
        "refresh": 2000
      },
      "system_status": {
        "enabled": true,
        "position": "bottom",
        "refresh": 5000
      },
      "agent_performance": {
        "enabled": true,
        "position": "bottom",
        "refresh": 10000
      }
    },
    "interactive_features": {
      "manual_task_trigger": true,
      "agent_control": {
        "start": true,
        "stop": true,
        "restart": true
      },
      "reward_override": {
        "enabled": true,
        "require_auth": true
      },
      "payment_approval": {
        "enabled": true,
        "threshold": 0.1,
        "require_mfa": true
      }
    },
    "security": {
      "auth_required": true,
      "session_timeout": 3600,
      "ip_whitelist": [],
      "rate_limit": {
        "requests_per_minute": 120,
        "burst": 20
      }
    }
  }
}
