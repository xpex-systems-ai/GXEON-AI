# GXEON Dashboard Environment Variables
# ⚠️ NEVER commit this file with real values - use .env.local instead

# Backend API URL (Production)
VITE_API_BASE_URL=https://gxeon-ai.xmentex2.replit.app

# System API Key for backend authentication
VITE_SYSTEM_API_KEY=your_system_api_key_here

# Alchemy RPC URL for Sepolia Testnet (get free key at https://alchemy.com)
VITE_ALCHEMY_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# QuickNode Arbitrum RPC (Premium - optional)
VITE_QUICKNODE_ARBITRUM_URL=https://your-node.arbitrum-mainnet.quiknode.pro/YOUR_TOKEN

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ==========================================
# EXAMPLE FOR LOCAL DEVELOPMENT
# ==========================================
# VITE_API_BASE_URL=http://localhost:3000
# VITE_SYSTEM_API_KEY=test-key-123
# VITE_ALCHEMY_RPC_URL=https://rpc.sepolia.org
# VITE_SUPABASE_URL=http://localhost:54321
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
