{
  "openapi": "3.0.3",
  "info": {
    "title": "GXEON Sovereign M2M API",
    "description": "The Ultra-Low Latency Arbitrum Mempool Radar for AI Agents. High-frequency mempool scanning and arbitrage signals for autonomous trading agents. Machine-to-Machine monetization with strict billing enforcement.",
    "version": "2.2.0",
    "contact": {
      "name": "GXEON Support",
      "email": "api@gxeon.ai",
      "url": "https://gxeon.ai"
    },
    "license": {
      "name": "Enterprise License",
      "url": "https://gxeon.ai/license"
    },
    "x-logo": {
      "url": "https://gxeon.ai/assets/logo-gold.png",
      "backgroundColor": "#0d1421",
      "altText": "GXEON Logo"
    }
  },
  "servers": [
    {
      "url": "https://gxeon-ai.xmentex2.replit.app/api/v1",
      "description": "Production Server"
    },
    {
      "url": "https://gxeon-staging.xmentex2.replit.app/api/v1",
      "description": "Staging Server"
    }
  ],
  "tags": [
    {
      "name": "M2M Core",
      "description": "Machine-to-Machine sovereign data endpoints"
    },
    {
      "name": "Chainlink",
      "description": "Chainlink Functions oracle integration"
    },
    {
      "name": "Ocean Protocol",
      "description": "Ocean Protocol Compute-to-Data integration"
    },
    {
      "name": "Billing",
      "description": "Credit management and usage analytics"
    }
  ],
  "security": [
    {
      "ApiKeyAuth": []
    }
  ],
  "paths": {
    "/sovereign-data": {
      "get": {
        "tags": ["M2M Core"],
        "summary": "Get Sovereign M2M Data",
        "description": "Primary endpoint for autonomous agents to access mempool data, arbitrage opportunities, and flash loan pools. Returns real-time trading signals optimized for MEV bots and high-frequency trading algorithms.\n\n**Cost:** 0.05 credits per call\n**Target:** MEV Bots, Trading Algorithms, Autonomous Agents\n**Latency:** < 50ms average",
        "operationId": "getSovereignData",
        "parameters": [
          {
            "name": "x-gxeon-key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Your GXEON API key (format: gx_live_xxxxxxxx)"
          },
          {
            "name": "x-agent-id",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique agent identifier (e.g., mev-bot-v1)"
          },
          {
            "name": "x-agent-tier",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "enum": ["free", "pro", "whale"]
            },
            "description": "Agent subscription tier (defaults to your account tier)"
          },
          {
            "name": "min_profit_bps",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 10
            },
            "description": "Minimum profit in basis points (100 bps = 1%)"
          },
          {
            "name": "max_results",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Maximum number of results to return"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful data retrieval",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SovereignDataResponse"
                },
                "example": {
                  "protocol": "PANDORA_M2M_v2.2",
                  "timestamp": 1713302400000,
                  "agent": {
                    "id": "bot-001",
                    "tier": "pro_agent",
                    "daily_calls": 247,
                    "remaining_credits": 152.45
                  },
                  "data": {
                    "mempool": {
                      "pending_tx_count": 143,
                      "high_value_tx": [],
                      "gas_price_gwei": 0.25,
                      "last_block": 184756230,
                      "congestion_level": "medium"
                    },
                    "arbitrage": {
                      "opportunities": [
                        {
                          "id": "arb_1713302400",
                          "dex_pair": "UNI-V2: WETH/USDC",
                          "profit_bps": 15,
                          "size_usd": 45000,
                          "confidence": 0.92,
                          "protocol": "uniswap_v3",
                          "token_in": "WETH",
                          "token_out": "USDC",
                          "expires_at": "2026-04-17T00:00:30Z",
                          "route": [
                            {"protocol": "uniswap_v3", "token_in": "WETH", "token_out": "USDC"}
                          ]
                        }
                      ],
                      "flash_loan_pools": [
                        {"protocol": "Aave V3", "available": "$2.5M", "apy": "3.2%", "token": "WETH"},
                        {"protocol": "Balancer", "available": "$1.8M", "apy": "2.9%", "token": "USDC"}
                      ]
                    },
                    "mev": {
                      "pending_bundles": 3,
                      "bribe_estimate_gwei": 25
                    }
                  },
                  "meta": {
                    "response_time_ms": 42,
                    "credits_cost": 0.05,
                    "api_version": "2.2.0",
                    "next_call_min_delay_ms": 100
                  }
                }
              }
            },
            "headers": {
              "X-Response-Time": {
                "description": "API response time in milliseconds",
                "schema": {
                  "type": "string",
                  "example": "42ms"
                }
              },
              "X-Agent-Tier": {
                "description": "Agent tier level",
                "schema": {
                  "type": "string",
                  "example": "pro_agent"
                }
              },
              "X-Credits-Deducted": {
                "description": "Credits deducted for this call",
                "schema": {
                  "type": "string",
                  "example": "0.05"
                }
              },
              "X-M2M-Protocol": {
                "description": "Protocol version",
                "schema": {
                  "type": "string",
                  "example": "PANDORA_v2.2"
                }
              },
              "X-Rate-Limit": {
                "description": "Current rate limit (calls per minute)",
                "schema": {
                  "type": "string",
                  "example": "600"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing API key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "GXEON_AUTH_REQUIRED",
                  "message": "API Key obrigatória. Header 'x-gxeon-key' ausente ou inválida.",
                  "code": 401
                }
              }
            }
          },
          "402": {
            "description": "Payment Required - Insufficient credits",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "GXEON_PAYMENT_REQUIRED",
                  "message": "Saldo insuficiente. Recarregue seus créditos.",
                  "required": 0.05,
                  "current_balance": 0.02,
                  "recharge_url": "https://gxeon-ai.xmentex2.replit.app/billing/recharge",
                  "code": 402
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Human browser detected (M2M only)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "GXEON_M2M_ONLY",
                  "message": "This endpoint is restricted to autonomous agents. Browser access denied.",
                  "human_detected": true,
                  "code": 403
                }
              }
            }
          },
          "429": {
            "description": "Rate Limited - Daily limit exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "error": "GXEON_RATE_LIMITED",
                  "message": "Daily call limit exceeded. Upgrade to Pro or Whale tier.",
                  "tier": "free",
                  "limit": 10,
                  "used": 10,
                  "code": 429
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error"
          }
        }
      }
    },
    "/sovereign-data/batch": {
      "post": {
        "tags": ["M2M Core"],
        "summary": "Batch Request (10% Discount)",
        "description": "Submit multiple sovereign data requests in a single call. Get 10% discount on batch requests of 10 or more.\n\n**Cost:** 0.045 credits per request (10% discount)\n**Max Batch Size:** 100 requests",
        "operationId": "batchSovereignData",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/BatchRequest"
              },
              "example": {
                "requests": [
                  {"tier": "whale", "filters": ["mev", "arbitrage"]},
                  {"tier": "whale", "filters": ["flash_loan"]},
                  {"tier": "whale"}
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Batch request successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BatchResponse"
                }
              }
            }
          }
        }
      }
    },
    "/sovereign-data/tier-info": {
      "get": {
        "tags": ["Billing"],
        "summary": "Get Tier Information",
        "description": "Free endpoint to check available agent tiers, pricing, and features. No credits required.\n\n**Cost:** 0.00 credits",
        "operationId": "getTierInfo",
        "responses": {
          "200": {
            "description": "Tier information retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TierInfoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/billing/balance": {
      "get": {
        "tags": ["Billing"],
        "summary": "Check Credit Balance",
        "description": "Check current credit balance and usage statistics.\n\n**Cost:** 0.00 credits",
        "operationId": "getBalance",
        "responses": {
          "200": {
            "description": "Balance information",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BalanceResponse"
                }
              }
            }
          }
        }
      }
    },
    "/chainlink/oracle": {
      "get": {
        "tags": ["Chainlink"],
        "summary": "Chainlink Functions Oracle",
        "description": "Oracle endpoint for Chainlink Functions integration. Returns arbitrage signals formatted for on-chain consumption.\n\n**Cost:** 0.10 credits per call\n**Format:** JSON-RPC 2.0 compliant\n**Network:** Arbitrum",
        "operationId": "chainlinkOracle",
        "parameters": [
          {
            "name": "x-source",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Must be 'chainlink'"
          },
          {
            "name": "x-chainlink-job-id",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Chainlink job ID for tracking"
          },
          {
            "name": "min_profit_bps",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 10
            },
            "description": "Minimum profit in basis points"
          },
          {
            "name": "max_results",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 5,
              "maximum": 20
            },
            "description": "Maximum results (Chainlink gas optimized)"
          }
        ],
        "responses": {
          "200": {
            "description": "Oracle data retrieved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChainlinkOracleResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden - Not Chainlink source"
          }
        }
      }
    },
    "/chainlink/automation/trigger": {
      "post": {
        "tags": ["Chainlink"],
        "summary": "Chainlink Automation Trigger",
        "description": "Endpoint for Chainlink Automation (Keepers) to trigger actions based on on-chain conditions.\n\n**Cost:** 0.15 credits per trigger",
        "operationId": "chainlinkAutomation",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AutomationTriggerRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Automation trigger executed"
          }
        }
      }
    },
    "/ocean/compute": {
      "post": {
        "tags": ["Ocean Protocol"],
        "summary": "Ocean C2D Compute Job",
        "description": "Compute-to-Data job execution for Ocean Protocol integration. Run algorithms against GXEON mempool data.\n\n**Cost:** 0.05 credits per job",
        "operationId": "oceanCompute",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OceanComputeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "C2D job completed",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OceanComputeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["System"],
        "summary": "Health Check",
        "description": "Check API health status and latency.\n\n**Cost:** 0.00 credits",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "API operational",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "operational"
                    },
                    "version": {
                      "type": "string",
                      "example": "2.2.0"
                    },
                    "timestamp": {
                      "type": "integer"
                    },
                    "uptime": {
                      "type": "number",
                      "example": 99.9
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-gxeon-key",
        "description": "GXEON API Key (obtain from dashboard)"
      }
    },
    "schemas": {
      "SovereignDataResponse": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string",
            "example": "PANDORA_M2M_v2.2"
          },
          "timestamp": {
            "type": "integer",
            "example": 1713302400000
          },
          "agent": {
            "$ref": "#/components/schemas/AgentInfo"
          },
          "data": {
            "$ref": "#/components/schemas/SovereignData"
          },
          "meta": {
            "$ref": "#/components/schemas/ResponseMeta"
          }
        },
        "required": ["protocol", "timestamp", "agent", "data", "meta"]
      },
      "AgentInfo": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "bot-001"
          },
          "tier": {
            "type": "string",
            "enum": ["free", "pro_agent", "whale_agent"],
            "example": "pro_agent"
          },
          "daily_calls": {
            "type": "integer",
            "example": 247
          },
          "remaining_credits": {
            "type": "number",
            "format": "float",
            "example": 152.45
          }
        }
      },
      "SovereignData": {
        "type": "object",
        "properties": {
          "mempool": {
            "$ref": "#/components/schemas/MempoolData"
          },
          "arbitrage": {
            "$ref": "#/components/schemas/ArbitrageData"
          },
          "mev": {
            "$ref": "#/components/schemas/MEVData"
          }
        }
      },
      "MempoolData": {
        "type": "object",
        "properties": {
          "pending_tx_count": {
            "type": "integer",
            "example": 143
          },
          "high_value_tx": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "gas_price_gwei": {
            "type": "number",
            "example": 0.25
          },
          "last_block": {
            "type": "integer",
            "example": 184756230
          },
          "congestion_level": {
            "type": "string",
            "enum": ["low", "medium", "high"],
            "example": "medium"
          }
        }
      },
      "ArbitrageData": {
        "type": "object",
        "properties": {
          "opportunities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ArbitrageOpportunity"
            }
          },
          "flash_loan_pools": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FlashLoanPool"
            }
          }
        }
      },
      "ArbitrageOpportunity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "dex_pair": {
            "type": "string",
            "example": "UNI-V2: WETH/USDC"
          },
          "profit_bps": {
            "type": "integer",
            "description": "Profit in basis points (100 = 1%)",
            "example": 15
          },
          "size_usd": {
            "type": "number",
            "example": 45000
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "example": 0.92
          },
          "protocol": {
            "type": "string",
            "example": "uniswap_v3"
          },
          "token_in": {
            "type": "string",
            "example": "WETH"
          },
          "token_out": {
            "type": "string",
            "example": "USDC"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "route": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "FlashLoanPool": {
        "type": "object",
        "properties": {
          "protocol": {
            "type": "string",
            "enum": ["Aave V3", "Balancer", "dYdX", "Uniswap V3"],
            "example": "Aave V3"
          },
          "available": {
            "type": "string",
            "example": "$2.5M"
          },
          "apy": {
            "type": "string",
            "example": "3.2%"
          },
          "token": {
            "type": "string",
            "example": "WETH"
          }
        }
      },
      "MEVData": {
        "type": "object",
        "properties": {
          "pending_bundles": {
            "type": "integer",
            "example": 3
          },
          "bribe_estimate_gwei": {
            "type": "integer",
            "example": 25
          }
        }
      },
      "ResponseMeta": {
        "type": "object",
        "properties": {
          "response_time_ms": {
            "type": "integer",
            "example": 42
          },
          "credits_cost": {
            "type": "number",
            "example": 0.05
          },
          "api_version": {
            "type": "string",
            "example": "2.2.0"
          },
          "next_call_min_delay_ms": {
            "type": "integer",
            "example": 100
          }
        }
      },
      "BatchRequest": {
        "type": "object",
        "properties": {
          "requests": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "object",
              "properties": {
                "tier": {
                  "type": "string"
                },
                "filters": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      },
      "BatchResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "batch_id": {
            "type": "string"
          },
          "total_requests": {
            "type": "integer"
          },
          "total_cost": {
            "type": "number",
            "description": "Total credits consumed with discount"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SovereignDataResponse"
            }
          },
          "discount_applied": {
            "type": "boolean",
            "description": "10% discount applied for batch >= 10"
          }
        }
      },
      "TierInfoResponse": {
        "type": "object",
        "properties": {
          "tiers": {
            "type": "object",
            "properties": {
              "free": {
                "$ref": "#/components/schemas/TierDetails"
              },
              "pro": {
                "$ref": "#/components/schemas/TierDetails"
              },
              "whale": {
                "$ref": "#/components/schemas/TierDetails"
              }
            }
          }
        }
      },
      "TierDetails": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "daily_limit": {
            "type": "integer",
            "nullable": true
          },
          "rate_limit_ms": {
            "type": "integer"
          },
          "monthly_price_usd": {
            "type": "number",
            "nullable": true
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "BalanceResponse": {
        "type": "object",
        "properties": {
          "amount": {
            "type": "number",
            "example": 152.45
          },
          "currency": {
            "type": "string",
            "example": "credits"
          },
          "usage_today": {
            "type": "object",
            "properties": {
              "calls": {
                "type": "integer"
              },
              "credits_spent": {
                "type": "number"
              }
            }
          }
        }
      },
      "ChainlinkOracleResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "jsonrpc": {
            "type": "string",
            "example": "2.0"
          },
          "id": {
            "type": "string"
          },
          "result": {
            "type": "object",
            "properties": {
              "signals": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "pair": {"type": "string"},
                    "profit_bps": {"type": "integer"},
                    "size_usd": {"type": "integer"},
                    "confidence": {"type": "integer"},
                    "route_hash": {"type": "string"}
                  }
                }
              },
              "timestamp": {"type": "integer"},
              "chain": {"type": "string"},
              "source": {"type": "string"}
            }
          }
        }
      },
      "AutomationTriggerRequest": {
        "type": "object",
        "properties": {
          "trigger_type": {
            "type": "string",
            "enum": ["arbitrage_opportunity", "flash_loan_available", "gas_price_spike"]
          },
          "threshold": {
            "type": "number"
          },
          "action": {
            "type": "string"
          },
          "contract_address": {
            "type": "string"
          }
        }
      },
      "OceanComputeRequest": {
        "type": "object",
        "properties": {
          "algorithm": {
            "type": "string",
            "example": "arbitrage_scanner_v1"
          },
          "params": {
            "type": "object",
            "properties": {
              "chains": {
                "type": "array",
                "items": {"type": "string"}
              },
              "dexes": {
                "type": "array",
                "items": {"type": "string"}
              },
              "min_profit_usd": {
                "type": "number"
