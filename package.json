{
  "name": "gxeon-nexus-v4",
  "version": "4.0.0-sovereign",
  "description": "🌑 GXEON NEXUS v4.0 — Sovereign M2M Infrastructure for Autonomous Trading Agents | Júnior Sena — Sovereign AI Architect",
  "main": "server/index.js",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "start:legacy": "node server/index.js",
    "start:oracle": "node server/index.js",
    "production": "node server/production.js",
    "dev": "nodemon server/index.js",
    "compile": "npx hardhat compile --config hardhat.config.cjs",
    "deploy:executor": "node scripts/deploy_executor_contract.js deploy",
    "deploy:master": "node scripts/MASTER_DEPLOY_v4.js",
    "validate:sniper": "node scripts/validate_sniper_active.js",
    "verify:protocol": "node scripts/verify_protocol_ready.js",
    "flash:start": "node server/services/flashSweeper.js start",
    "flash:simulation": "node server/services/flashSweeper.js --simulation",
    "status": "node scripts/check_status.js",
    "profits": "node scripts/check_profits.js",
    "guardian:shield": "node scripts/guardian_shield.js",
    "setup:tables": "node scripts/setup_tables.js",
    "emergency:kill": "node scripts/emergency_stop.js",
    "grafana:import": "node grafana/setup/import-dashboards.js",
    "grafana:stop": "docker-compose -f grafana/setup/docker-compose.yml down",
    "radar:start": "node server/services/radarShix.js",
    "radar:mev": "npm run radar:start | npm run mev:start",
    "mev:start": "node server/services/mevMatchmaker.js",
    "mev:simulation": "cross-env MEV_LIVE_MODE=false node server/services/mevMatchmaker.js",
    "mev:live": "cross-env MEV_LIVE_MODE=true node server/services/mevMatchmaker.js",
    "test:flash": "node tests/test_flash_sweeper.js",
    "test:api": "node tests/test_api_endpoints.js",
    "audit:full": "node scripts/audit_system.js",
    "metrics:export": "node scripts/export_metrics.js",
    "fleet:dev": "node core/fleet_activation.js",
    "fleet:production": "NODE_ENV=production node core/fleet_production_deploy.js",
    "fleet:status": "node -e \"import('./core/fleet_production_deploy.js').then(m => console.log(m.commander.getStatus()))\"",
    "fleet:emergency": "node -e \"import('./core/fleet_production_deploy.js').then(m => m.commander.emergencyStop())\"",
    "harden:security": "node scripts/system_hardening.js",
    "grafana:deploy": "psql $SUPABASE_URL -f supabase/grafana_views_v10.sql",
    "grafana:fix": "node scripts/dashboard_ignition_fix.js",
    "grafana:sql-fix": "echo 'Execute: supabase/DASHBOARD_IGNITION_FIX.sql no SQL Editor'",
    "grafana:setup": "node scripts/grafana_connect_setup.js",
    "grafana:connect": "node scripts/grafana_cloud_sync.js",
    "grafana:apex": "node scripts/grafana_apex_deploy.js",
    "deploy:dashboard": "node scripts/deploy_dashboard.js",
    "nexus:multichain": "node core/multichain_parallel_processor.js",
    "humanity:sovereign": "node core/gxeon_humanity_sovereign_v21.js",
    "grafana:start": "alloy run grafana/config/alloy-config.river",
    "marketplace:start": "node server/index-marketplace.js",
    "marketplace:audit": "node scripts/marketplace_audit_validator.js",
    "marketplace:dev": "nodemon server/index-marketplace.js",
    "marketplace:schema": "echo 'Execute supabase/marketplace_supreme_schema.sql e supabase/observability_schema.sql no Supabase SQL Editor'",
    "marketplace:signals": "node scripts/start_marketplace_supreme.js"
  },
  "dependencies": {
    "@flashbots/mev-share-client": "^0.7.13",
    "@supabase/supabase-js": "^2.39.7",
    "alchemy-sdk": "^3.1.2",
    "axios": "^1.6.7",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "moment-timezone": "^0.5.45",
    "node-cron": "^3.0.3",
    "telegraf": "^4.16.3",
    "utf-8-validate": "^6.0.6",
    "uuid": "^9.0.0",
    "ws": "^8.16.0"
  },
  "author": "Commander Senna - GXeon AI",
  "license": "Proprietary",
  "devDependencies": {
    "@chainlink/contracts": "^1.5.0",
    "@nomicfoundation/hardhat-ethers": "^4.0.8",
    "@openzeppelin/contracts": "^5.6.1",
    "cross-env": "^10.1.0",
    "hardhat": "^3.4.0"
  }
}
