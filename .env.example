# GXEON Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=3000
NODE_ENV=production

# Supabase Database
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_URL=https://your-project.supabase.co

# Web3 Wallet
WEB3_WALLET_ADDRESS=0xYOUR_WALLET_ADDRESS
WALLET_PRIVATE_KEY=your_private_key_here
WEB3_NETWORK=Ethereum

# AI API Keys
OPENROUTER_API_KEY=your_openrouter_key_here
HUGGINGFACE_API_KEY=your_huggingface_key_here
DEEPSEEK_API_KEY=your_deepseek_key_here
GROK_API_KEY=your_grok_key_here
CHATGPT_API_KEY=your_chatgpt_key_here
BITENSOR_API_KEY=your_bitensor_key_here

# ==========================================
# SEPOLIA TESTNET DEPLOYMENT
# ==========================================
# RPC URL - Get free from https://alchemy.com or https://infura.io
SEPOLIA_RPC_URL=https://rpc.sepolia.org
# Private key with 0x prefix (NEVER commit this to git!)
PRIVATE_KEY=sua_chave_privada_aqui_com_prefixo_0x

# World Chain Sepolia RPC (optional - uses public fallback if not set)
WORLDCHAIN_RPC_URL=https://worldchain-sepolia.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Etherscan API Key for contract verification
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Deployed contract address (filled after deploy)
CONTRACT_ADDRESS=0x...
SMART_CONTRACT_ADDRESS=0x...

# ==========================================
# ARBITRUM MAINNET DEPLOYMENT - PRODUCTION
# ==========================================
# Get RPC from https://alchemy.com or https://quicknode.com
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc

# Arbiscan API Key for contract verification
# Get from: https://arbiscan.io/apis
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# Arbitrum Goerli (for testing)
ARBITRUM_GOERLI_RPC_URL=https://goerli-rollup.arbitrum.io/rpc

# POLYGON MAINNET (Backup network)
# RPC from https://polygon-rpc.com or Alchemy
POLYGON_RPC_URL=https://polygon-rpc.com

# PolygonScan API Key
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here

# ==========================================
# PRODUCTION CONTRACT ADDRESSES (after deploy)
# ==========================================
# These will be filled after running deploy_arbitrum.js
VAULT_ADDRESS=0x...
EXECUTOR_ADDRESS=0x...

# ==========================================
# FLASHBOTS MEV PROTECTION (Optional)
# ==========================================
# Use Flashbots RPC for private transactions
FLASHBOTS_RPC_URL=https://rpc.flashbots.net

# ==========================================
# FEATURE FLAGS
# ==========================================
PAYMENT_ON_TASK_COMPLETION=false
ENABLE_FLASHBOTS=true
MIN_PROFIT_THRESHOLD_USD=10

# ==========================================
# MONETIZATION
# ==========================================
MONETIZATION_ENDPOINT=
REINVESTMENT_PERCENT=70
COMMANDER_PAYOUT_PERCENT=30

# ==========================================
# NETLIFY DEPLOYMENT (GitHub Actions)
# ==========================================
# Get these from your Netlify dashboard: https://app.netlify.com/sites/gxeonai/settings/deploys
NETLIFY_AUTH_TOKEN=your_netlify_auth_token_here
NETLIFY_SITE_ID=your_netlify_site_id_here

# ==========================================
# WEB3 PLATFORM INTEGRATIONS - OCEAN PROTOCOL
# ==========================================
# Get from: https://market.oceanprotocol.com
OCEAN_NETWORK=arbitrum
OCEAN_NETWORK_URL=https://arb1.arbitrum.io/rpc
OCEAN_ASSET_NAME=GXEON Sovereign M2M Radar
OCEAN_ASSET_SYMBOL=GXEON-DATA
OCEAN_PROVIDER_URL=https://gxeon-ai.xmentex2.replit.app
OCEAN_PRICE=50

# Deployed Data NFT address (filled after ocean_deploy.js)
OCEAN_DATANFT_ADDRESS=0x...
OCEAN_DATATOKEN_ADDRESS=0x...
OCEAN_DID=did:op:...

# ==========================================
# WEB3 PLATFORM INTEGRATIONS - CHAINLINK
# ==========================================
# Get from: https://functions.chain.link
CHAINLINK_ROUTER_ADDRESS=0x...  # Arbitrum Functions Router
CHAINLINK_DON_ID=fun-arbitrum-1
CHAINLINK_SUBSCRIPTION_ID=your_subscription_id
CHAINLINK_GAS_LIMIT=300000
LINK_TOKEN_ADDRESS=0xf97f4df75117a78c1A5a0DBb814Af92458539FB4

# Deployed Oracle address (filled after deploy)
CHAINLINK_ORACLE_ADDRESS=0x...

# ==========================================
# GXEON TREASURY - REVENUE CENTRALIZATION
# ==========================================
# Deployed Treasury contract address
GXEON_TREASURY_ADDRESS=0x...

# Commander wallet (30% share recipient)
COMMANDER_ADDRESS=0x3955d559055DadB7067054cB6E6f974710345224

# Minimum settlement thresholds
MIN_SETTLEMENT_ETH=0.01
MIN_SETTLEMENT_USDC=25

# Revenue distribution (basis points)
VAULT_SHARE_BPS=7000      # 70%
COMMANDER_SHARE_BPS=3000  # 30%

# ==========================================
# RAPIDAPI MARKETPLACE
# ==========================================
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_API_ID=your_api_id_here
