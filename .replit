# ═══════════════════════════════════════════════════════════════════════════════
# 🌑 GXEON AI — SUPREMO AUTO-DEPLOY CONFIGURATION v2.1.0
# 1-Click → Import → Auto-Config → Monetize → Profit
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# 🚀 RUNTIME CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════════

# Entry point when "Run" button is clicked
run = "npm start"

# Entry point when "Deploy" button is clicked
deploy = "npm run deploy"

# Language and environment
language = "nodejs"

# ═══════════════════════════════════════════════════════════════════════════════
# 🌐 PORTS (Auto-exposed)
# ═══════════════════════════════════════════════════════════════════════════════

[ports]
3000 = "🌑 GXEON API Server — Billing Active"
3002 = "📊 Cyber-Gold Dashboard"
5173 = "⚡ Vite Dev Server"

# ═══════════════════════════════════════════════════════════════════════════════
# 🔐 AUTO-POPULATED SECRETS (Don't edit here — use Replit Secrets tab)
# ═══════════════════════════════════════════════════════════════════════════════

[env]
NODE_ENV = "production"
PORT = "3000"
GXEON_MODE = "sovereign"
BILLING_ENABLED = "true"
RADAR_ENABLED = "true"
GUARDIAN_ENABLED = "true"

# ═══════════════════════════════════════════════════════════════════════════════
# 📦 NIX PACKAGES
# ═══════════════════════════════════════════════════════════════════════════════

[nix]
packages = [
  "nodejs-20_x",
  "nodePackages.npm",
  "nodePackages.pnpm",
  "git",
  "postgresql"
]

# ═══════════════════════════════════════════════════════════════════════════════
# 🔄 LIFECYCLE HOOKS
# ═══════════════════════════════════════════════════════════════════════════════

[lifecycle]
# Auto-install on boot
onBoot = """
echo '🌑 GXEON SOVEREIGN v2.1.0 Initializing...'
npm install
cd dashboard && npm install && npm run build
cd ..
echo '✅ Build Complete — Ready for Autonomous Execution'
"""

# Startup message
onStart = """
echo ''
echo '╔═══════════════════════════════════════════════════════════════╗'
echo '║              🌑 GXEON AI — SUPREMO GRID v2.1.0                ║'
echo '╠═══════════════════════════════════════════════════════════════╣'
echo '║  Status: READY FOR MONETIZATION                               ║'
echo '║  Billing: 0.05 credits/radar call — ACTIVE                    ║'
echo '║  Dashboard: Cyber-Gold UI — Real-time Stats                   ║'
echo '║  Flashloans: M2M Atomic Execution — ARMED                     ║'
echo '╚═══════════════════════════════════════════════════════════════╝'
echo ''
echo '💰 MONETIZATION ACTIVE — Sistema pronto para faturar!'
echo '🚀 Click ▶ RUN to start the Sovereign Grid'
"""

# ═══════════════════════════════════════════════════════════════════════════════
# 💰 MONETIZATION CONFIGURATION (AUTO-CONFIGURED)
# ═══════════════════════════════════════════════════════════════════════════════

[monetization]
enabled = true
currency = "credits"

[monetization.rates]
radar_call = 0.05
llm_call = 0.001
agent_execution = 0.005
onchain_operation = 0.015

[monetization.tiers]
free = { credits = 100, price = 0 }
pro = { credits = 1000, price = 29.99 }
enterprise = { credits = 10000, price = 199.99 }

# ═══════════════════════════════════════════════════════════════════════════════
# ⚡ FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════════════════════

[features]
flashloans = { enabled = true, networks = ["arbitrum", "ethereum", "polygon"] }
radar = { enabled = true, interval = 300000 }
guardian = { enabled = true, autoHeal = true }
dashboard = { enabled = true, port = 3002 }

# ═══════════════════════════════════════════════════════════════════════════════
# 📋 QUICK SETUP (3 STEPS)
# ═══════════════════════════════════════════════════════════════════════════════
# 
# STEP 1: Import
#    → This page! Already have the URL? Just click [Import]
# 
# STEP 2: Secrets (Auto-configured from replit-supremo.json)
#    → Click 'Secrets' tab → All values are pre-filled
#    → Just click [Add] for each secret
# 
# STEP 3: RUN & PROFIT
#    → Click ▶ RUN
#    → Dashboard opens automatically
#    → Billing is LIVE — every API call = $$$
#
# ═══════════════════════════════════════════════════════════════════════════════
