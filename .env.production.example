# ═══════════════════════════════════════════════════════════════════════════
# GXEON FLEET DEPLOYMENT v10.0 - PRODUCTION ENVIRONMENT VARIABLES
# 
# ⚠️  ATENÇÃO: Estas são variáveis sensíveis. NUNCA commite este arquivo!
# 
# Autorizado por: Comandante Júnior Sena
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# SUPABASE - Database Connection (REQUIRED)
# ═══════════════════════════════════════════════════════════════════════════
SUPABASE_PROJECT_URL=https://telxvphgrsvsnxvmjkce.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ═══════════════════════════════════════════════════════════════════════════
# WEB3 - Blockchain Connections (REQUIRED)
# ═══════════════════════════════════════════════════════════════════════════
# Alchemy WebSocket (Arbitrum) - Para latência < 100ms
ALCHEMY_ARBITRUM_WS_URL=wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Alchemy HTTP RPC (Arbitrum)
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Ethereum RPC (fallback)
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# Wallet Private Key (sem 0x prefix)
# ⚠️  CRÍTICO: Esta é a chave que executa transações e recebe lucros
PRIVATE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════════════════
# API KEYS - External Services (REQUIRED)
# ═══════════════════════════════════════════════════════════════════════════
ALCHEMY_API_KEY=YOUR_ALCHEMY_KEY
HUGGINGFACE_API_KEY=hf_...

# ═══════════════════════════════════════════════════════════════════════════
# SECURITY - Encryption and Protection (REQUIRED)
# ═══════════════════════════════════════════════════════════════════════════
# Chave para criptografia M2M
SWARM_ENCRYPTION_KEY=your-256-bit-encryption-key-here

# ═══════════════════════════════════════════════════════════════════════════
# TREASURY - Profit Destination (LOCKED - DO NOT CHANGE)
# ═══════════════════════════════════════════════════════════════════════════
# Este endereço é fixo e não pode ser alterado em produção
PROFIT_DESTINATION=0x3955d559055DadB7067054cB6E6f974710345224
TREASURY_LOCK=true

# ═══════════════════════════════════════════════════════════════════════════
# FLEET CONFIGURATION - Performance Tuning (OPTIONAL)
# ═══════════════════════════════════════════════════════════════════════════
# Modo de operação
NODE_ENV=production
FLEET_SIMULATION_MODE=false

# Logging
LOG_LEVEL=ERROR
SILENT_MODE=true

# Circuit Breaker
CIRCUIT_BREAKER_ENABLED=true
MAX_CONSECUTIVE_ERRORS=5

# Intervals (em milissegundos/horas)
AIRDROP_CYCLE_HOURS=6
TASK_SCAN_INTERVAL_MS=30000
LIQUIDITY_SCAN_INTERVAL_MS=1000
GOVERNANCE_SCAN_INTERVAL_MS=300000

# Profit Thresholds
MIN_PROFIT_USD=5
MAX_GAS_GWEI=0.1
EMERGENCY_PROFIT_THRESHOLD=1000

# ═══════════════════════════════════════════════════════════════════════════
# FEATURE FLAGS (OPTIONAL)
# ═══════════════════════════════════════════════════════════════════════════
# Modo emergência (para quando precisar parar tudo)
EMERGENCY_KILL_SWITCH=INACTIVE

# Just-In-Time Liquidity
JIT_MODE=true

# ═══════════════════════════════════════════════════════════════════════════
# MONITORING (Internal Supabase Only - No External Costs)
# ═══════════════════════════════════════════════════════════════════════════
SUPABASE_MONITORING=true
EXTERNAL_MONITORING=false

# ═══════════════════════════════════════════════════════════════════════════
# RAILWAY DEPLOYMENT (Auto-detected)
# ═══════════════════════════════════════════════════════════════════════════
PORT=3000
RAILWAY_ENVIRONMENT=production

# ═══════════════════════════════════════════════════════════════════════════
# INSTRUCTIONS FOR RAILWAY DEPLOYMENT:
# ═══════════════════════════════════════════════════════════════════════════
# 1. Copy this file to .env.production
# 2. Fill in all YOUR_* values with real credentials
# 3. Upload to Railway Dashboard → Variables
# 4. Or use Railway CLI: railway variables set KEY=VALUE
# 5. Deploy with: railway up
# 
# SECURITY CHECKLIST:
# ☐ PRIVATE_KEY nunca exposta em logs
# ☐ SUPABASE_SERVICE_ROLE_KEY com service_role (não anon)
# ☐ SWARM_ENCRYPTION_KEY com 256 bits
# ☐ .env.production no .gitignore
# ☐ TREASURY_LOCK=true (verificar)
# ═══════════════════════════════════════════════════════════════════════════
