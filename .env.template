# ═══════════════════════════════════════════════════════════════════════════
# GXEON Production Environment Template
# 
# INSTRUÇÕES:
# 1. Copie este arquivo para .env
# 2. Substitua os valores abaixo com suas credenciais reais
# 3. NUNCA commite o arquivo .env!
# ═══════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════
# SUPABASE (Obrigatório para Ledger)
# Obtenha em: https://app.supabase.com/project/_/settings/api
# Use a "Project URL" e "service_role key" (não a anon key!)
# ═══════════════════════════════════════════════════════════════════════════
SUPABASE_PROJECT_URL=https://SEU-PROJECT-ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...sua-service-role-key

# ═══════════════════════════════════════════════════════════════════════════
# TELEGRAM (Opcional - para alertas)
# Obtenha com @BotFather: https://t.me/botfather
# ═══════════════════════════════════════════════════════════════════════════
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_CHAT_ID=8506789322

# ═══════════════════════════════════════════════════════════════════════════
# SERVER CONFIG
# ═══════════════════════════════════════════════════════════════════════════
PORT=3000
BASE_URL=https://gxeon-ia-production.up.railway.app

# ═══════════════════════════════════════════════════════════════════════════
# INTERNAL (Auto-gerado, não modificar)
# ═══════════════════════════════════════════════════════════════════════════
INTERNAL_API_KEY=internal_chave_secreta_aqui
SIGNAL_HUB_URL=http://localhost:3000/v1/signals/inject

# ═══════════════════════════════════════════════════════════════════════════
# BLOCKCHAIN RPCs (Opcional - para execução on-chain)
# ═══════════════════════════════════════════════════════════════════════════
# ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
# ETH_RPC_URL=https://eth.llamarpc.com
# POLYGON_RPC_URL=https://polygon-rpc.com
# BASE_RPC_URL=https://mainnet.base.org
