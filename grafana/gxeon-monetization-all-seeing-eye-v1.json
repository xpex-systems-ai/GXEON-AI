        "type": "logs",
        "targets": [
          {
            "refId": "A",
            "datasource": {
              "type": "postgres",
              "uid": "gxeon-pooler"
            },
            "rawSql": "SELECT timestamp AS time, agent_name, log_level, message FROM grafana_ai_logs ORDER BY timestamp DESC LIMIT 100",
            "format": "table"
          }
        ],
        "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
        "options": {
          "showTime": true,
          "wrapLogMessage": true,
          "sortOrder": "Descending",
          "enableLogDetails": true
        },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "hidden": false
            }
          },
          "overrides": [
            {
              "matcher": {
                "id": "byName",
                "options": "log_level"
              },
              "properties": [
                {
                  "id": "custom.hidden",
                  "value": false
                },
                {
                  "id": "mappings",
                  "value": [
                    {
                      "options": {
                        "ERROR": {
                          "color": "red",
                          "index": 0,
                          "text": "🔴 ERROR"
                        },
                        "INFO": {
                          "color": "blue",
                          "index": 1,
                          "text": "ℹ️ INFO"
                        },
                        "SUCCESS": {
                          "color": "green",
                          "index": 2,
                          "text": "✅ SUCCESS"
                        },
                        "WARN": {
                          "color": "yellow",
                          "index": 3,
                          "text": "⚠️ WARN"
                        }
                      },
                      "type": "value"
                    }
                  ]
                }
              ]
            }
          ]
        },
