# ═══════════════════════════════════════════════════════════════════════════════
# 🚂 GXEON AI — Exemplo de .env para Railway.app
# Copie este arquivo para .env e preencha seus valores reais
# ═══════════════════════════════════════════════════════════════════════════════

# ═══════════════════════════════════════════════════════════════════════════════
# ⚠️  VARIÁVEIS OBRIGATÓRIAS (sem estas o app não inicia)
# ═══════════════════════════════════════════════════════════════════════════════

# Supabase — Banco de dados principal
SUPABASE_PROJECT_URL=https://seu-projeto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_URL=https://seu-projeto.supabase.co

# Sistema — Autenticação interna
SYSTEM_ADMIN_ID=admin_$(date +%s)
SYSTEM_API_KEY=sua_chave_api_segura_aqui_min_32_chars

# AI — OpenRouter (acesso a múltiplos LLMs)
OPENROUTER_API_KEY=sk-or-v1-...

# Server
PORT=3000
NODE_ENV=production

# ═══════════════════════════════════════════════════════════════════════════════
# 🔧 VARIÁVEIS OPCIONAIS (habilitam funcionalidades extras)
# ═══════════════════════════════════════════════════════════════════════════════

# Web3 — Operações blockchain
PRIVATE_KEY=0x...
ARBITRUM_RPC_URL=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Swarm M2M — Colmeia predadora
SWARM_AUTOSTART=true
SWARM_INTERVAL=3600000
SWARM_MAX_AGENTS=50
SWARM_ENCRYPT=true
SWARM_OPTIMIZE=true
SWARM_PROFIT_THRESHOLD=1.0
SWARM_ENCRYPTION_KEY=sua_chave_32_caracteres_aqui

# RadarShix — Monitoramento social
TWITTER_BEARER_TOKEN=AAAAAAAAAAAA...
TWITTER_API_KEY=opcional

# AI Adicional
HUGGINGFACE_API_KEY=hf_...
DEEPSEEK_API_KEY=sk-...
GROK_API_KEY=xai-...
CHATGPT_API_KEY=sk-...
BITENSOR_API_KEY=...

# Monetização
PAYMENT_ON_TASK_COMPLETION=false
REINVESTMENT_PERCENT=70
COMMANDER_PAYOUT_PERCENT=30

# Feature Flags
ENABLE_FLASHBOTS=true
MIN_PROFIT_THRESHOLD_USD=10
DISABLE_GUARDIAN=false
DISABLE_RADAR=false

# ═══════════════════════════════════════════════════════════════════════════════
# 📝 INSTRUÇÕES PARA RAILWAY
# ═══════════════════════════════════════════════════════════════════════════════
# 
# 1. Copie este arquivo para .env
# 2. Preencha os valores reais (obrigatórios mínimo)
# 3. No Railway Dashboard, vá em "Variables"
# 4. Adicione uma a uma ou use "Bulk Edit" para copiar tudo
# 5. Deploy!
#
# NOTA: NUNCA commite o arquivo .env real no git!
# O .env está no .gitignore para proteção.
#
# ═══════════════════════════════════════════════════════════════════════════════
