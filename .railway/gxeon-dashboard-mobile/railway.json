{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "BASE_PATH=${BASE_PATH:-/} EXPO_PUBLIC_DOMAIN=${EXPO_PUBLIC_DOMAIN:-$RAILWAY_PUBLIC_DOMAIN} pnpm --filter @workspace/gxeon-dashboard-mobile run build",
    "watchPatterns": [
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig*.json",
      "/artifacts/gxeon-dashboard-mobile/**"
    ]
  },
  "deploy": {
    "startCommand": "PORT=$PORT BASE_PATH=${BASE_PATH:-/} pnpm --filter @workspace/gxeon-dashboard-mobile run serve",
    "healthcheckPath": "/",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
