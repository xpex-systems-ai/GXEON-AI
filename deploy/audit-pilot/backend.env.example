# Blueprint only. No credentials, deployment or pilot authorization supplied.
NODE_ENV=production
PORT=8080
GXEON_AUDIT_PILOT_ENABLED=false
GXEON_AUDIT_DB_PROVIDER=postgres
GXEON_AUDIT_WRITE_MODE=disabled
GXEON_AUDIT_ALLOW_DB_WRITES=false
GXEON_AUDIT_AUTO_RUN_MISSION_006=false
GXEON_AUDIT_AUTO_CREATE_FIRST_PROPOSAL=false
# Private Railway host, database gx01_pilot, role gx01_pilot_app; set privately.
DATABASE_URL=
# Distinct random credentials, at least 32 random bytes encoded base64url.
GXEON_AUDIT_OPERATOR_TOKEN=
GXEON_AUDIT_REVIEWER_TOKEN=
# Exact HTTPS frontend origin(s), no wildcard, path or trailing slash.
GXEON_AUDIT_ALLOWED_ORIGINS=
# Trusted CA for PostgreSQL TLS when not trusted by the system. Verification is mandatory.
GXEON_AUDIT_DATABASE_TLS_CA=
