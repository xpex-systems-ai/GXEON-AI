NODE_ENV=production
PORT=8443
GXEON_AUDIT_BIND_HOST=127.0.0.1
GXEON_AUDIT_DEPLOYMENT_MODE=private
GXEON_AUDIT_DATABASE_HOST=postgres
DATABASE_URL_FILE=/absolute/private/database-url
GXEON_AUDIT_DATABASE_TLS_CA_FILE=/absolute/private/ca.crt
GXEON_AUDIT_HTTPS_CERT_FILE=/absolute/private/web.crt
GXEON_AUDIT_HTTPS_KEY_FILE=/absolute/private/web.key
GXEON_AUDIT_FRONTEND_ROOT=/absolute/release/public
GXEON_AUDIT_ALLOWED_ORIGINS=https://localhost:8443
GXEON_AUDIT_PILOT_ENABLED=true
GXEON_AUDIT_DB_PROVIDER=postgres
GXEON_AUDIT_OPERATOR_TOKEN_FILE=/absolute/private/operator-token
GXEON_AUDIT_REVIEWER_TOKEN_FILE=/absolute/private/reviewer-token
GXEON_AUDIT_WRITE_MODE=enabled
GXEON_AUDIT_ALLOW_DB_WRITES=true
GXEON_AUDIT_AUTO_RUN_MISSION_006=false
GXEON_AUDIT_AUTO_CREATE_FIRST_PROPOSAL=false
GXEON_OMNIX_PREVIEW_ENABLED=true
GXEON_OMNIX_PREVIEW_IDENTITIES_FILE=/absolute/private/identities.json
