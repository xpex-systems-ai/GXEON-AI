# 🌑 GXEON AI — Dockerignore v10.0
# Excludes for optimized build

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files (SECURITY CRITICAL)
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production

# Logs
logs/
*.log
pids/
*.pid
*.seed
*.pid.lock

# Testing
coverage/
.nyc_output/

# Build artifacts
dist/
build/
.next/
.cache/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitignore

# Documentation (not needed in container)
*.md
!README.md
LICENSE
CHANGELOG.md
CONTRIBUTING.md

# CI/CD (not needed in container)
.github/
.gitlab-ci.yml
.travis.yml

# Docker compose files (but KEEP Dockerfile)
docker-compose*.yml

# Large binary files
*.tar.gz
*.zip
*.rar

# Temporary files
tmp/
temp/
*.tmp

# Dashboard build (built separately if needed)
dashboard/node_modules/
dashboard/dist/
dashboard/.env*

# Hardhat artifacts (not needed in prod runtime)
artifacts/
cache/
typechain-types/
