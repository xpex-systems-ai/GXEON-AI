# GXEON Extension Environment Configuration
# Browser Extension Settings

# API Configuration
API_BASE=https://your-gxeon-backend.com
AGENT_ID_PREFIX=agent_
FETCH_TIMEOUT=15000
ENV_MODE=production

# Wallet Configuration
WALLET_ADDR=0xYourWalletAddress
WALLET_CHAIN_ID=1

# Extension Feature Flags
ENABLE_AGENT_RUNNER=true
ENABLE_TASK_MONITOR=true
ENABLE_WALLET_CONNECTOR=true
ENABLE_DEBUG_HELPER=true
ENABLE_ANALYTICS_TRACKER=true

# Debug Settings
DEBUG_MODE=false
LOG_LEVEL=info
VERBOSE_LOGGING=false

# Performance Settings
POLL_INTERVAL=10000
METRICS_INTERVAL=60000
CACHE_TTL=300000

# Security
ALLOW_ALL_URLS=true
SECURE_CONNECTIONS_ONLY=false
